# Copy this file to `.env.local` and fill in the secrets. Both must match
# the values in your local g0v0-server's `.env` exactly, otherwise:
#   - JWT_SECRET_KEY mismatch  -> every JWT validation fails (every hub
#                                  call rejects with "invalid token")
#   - SHARED_INTEROP_SECRET     -> shared-interop calls (room creation, etc.)
#                                  fail HMAC verification on g0v0's side
#   - CLIENT_VERSION_WEBHOOK_   -> ToriiClientNameResolver auto-disables
#     SECRET                       (fine for local dev — verified Torii
#                                  badges just won't render)
#
# `.env.local` is gitignored.

# --- JWT signing key ---
# HS256 secret. Must match g0v0-server's JWT_SECRET_KEY exactly.
# (Look it up in `../g0v0-server/.env`.)
JWT_SECRET_KEY=

# --- Shared-interop secret ---
# HMAC secret used for spectator <-> g0v0 server calls. Must match
# g0v0-server's SHARED_INTEROP_SECRET exactly.
SHARED_INTEROP_SECRET=

# --- Client-version webhook secret ---
# Bearer token used by ToriiClientNameResolver to authenticate against
# g0v0's /api/private/client-versions/torii-hashes endpoint. Optional
# for local dev — when empty, the resolver disables itself and clients
# show without verified-Torii badges (rest of the spectator works fine).
CLIENT_VERSION_WEBHOOK_SECRET=

# --- MySQL password ---
# Empty by default (matches g0v0-server's local MySQL setup which uses
# unix-socket auth and ignores the Password= clause). Set to "password"
# if your local MySQL was started with the env-var password instead.
DB_PASSWORD=
